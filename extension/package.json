{
  "name": "@elsewise/extension",
  "private": true,
  "version": "0.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build --mode chrome && node scripts/verify-build.mjs chrome",
    "build:firefox": "vite build --mode firefox && node scripts/verify-build.mjs firefox",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/chrome": "^0.1.1",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.3"
  }
}
