{
  "$id": "https://elsewise.local/protocol/v3/source.discovered.schema.json",
  "additionalProperties": false,
  "properties": {
    "activity_key": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activity Key"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Capabilities",
      "type": "array"
    },
    "client_seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Client Seq",
      "type": "integer"
    },
    "driver_id": {
      "default": "browser_semantic",
      "maxLength": 128,
      "minLength": 1,
      "title": "Driver Id",
      "type": "string"
    },
    "driver_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Driver Version",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "health_status": {
      "enum": [
        "available",
        "waiting",
        "degraded",
        "unavailable",
        "failed"
      ],
      "title": "Health Status",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "platform": {
      "enum": [
        "google_meet",
        "microsoft_teams",
        "zoom",
        "synthetic"
      ],
      "title": "Platform",
      "type": "string"
    },
    "producer_epoch_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer Epoch Id",
      "type": "string"
    },
    "protocol_version": {
      "const": 3,
      "title": "Protocol Version",
      "type": "integer"
    },
    "tab_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tab Instance Id",
      "type": "string"
    },
    "type": {
      "const": "source.discovered",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "protocol_version",
    "event_id",
    "client_seq",
    "tab_instance_id",
    "producer_epoch_id",
    "platform",
    "driver_version",
    "capabilities",
    "health_status",
    "observed_at"
  ],
  "title": "SourceDiscovered",
  "type": "object"
}
