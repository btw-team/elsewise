{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elsewise.local/protocol/v1/source.status.schema.json",
  "title": "Source status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "event_id",
    "source_id",
    "client_seq",
    "platform",
    "enabled",
    "captions_status",
    "observed_at"
  ],
  "properties": {
    "type": { "const": "source.status" },
    "protocol_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tab_id": { "type": "integer", "minimum": 0 },
    "document_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "client_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "platform": {
      "enum": ["google_meet", "microsoft_teams", "zoom", "synthetic"]
    },
    "enabled": { "type": "boolean" },
    "captions_status": {
      "enum": [
        "unknown",
        "off",
        "on_empty",
        "capturing",
        "unavailable",
        "error"
      ]
    },
    "speaker_detection": { "enum": ["unknown", "available", "unavailable"] },
    "meeting_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "meeting_title": { "type": "string", "maxLength": 512 },
    "last_caption_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "diagnostic_code": { "type": "string", "maxLength": 128 }
  }
}
