{
  "$id": "https://elsewise.local/protocol/v2/ui.event.schema.json",
  "additionalProperties": false,
  "properties": {
    "aggregate_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregate Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_id": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Event Id",
      "type": "integer"
    },
    "event_type": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "protocol_version": {
      "const": 2,
      "title": "Protocol Version",
      "type": "integer"
    },
    "type": {
      "const": "ui.event",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "protocol_version",
    "event_id",
    "event_type",
    "created_at",
    "payload"
  ],
  "title": "UiEvent",
  "type": "object"
}
