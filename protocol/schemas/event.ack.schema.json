{
  "$id": "https://elsewise.local/protocol/v3/event.ack.schema.json",
  "additionalProperties": false,
  "properties": {
    "client_seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Client Seq",
      "type": "integer"
    },
    "details": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Details"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "protocol_version": {
      "const": 3,
      "title": "Protocol Version",
      "type": "integer"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "result": {
      "enum": [
        "applied",
        "duplicate",
        "stale",
        "no_active_session",
        "source_not_bound",
        "rejected"
      ],
      "title": "Result",
      "type": "string"
    },
    "type": {
      "const": "event.ack",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "protocol_version",
    "event_id",
    "client_seq",
    "result"
  ],
  "title": "EventAck",
  "type": "object"
}
